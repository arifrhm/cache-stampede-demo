[1.008, "o", "\u001b[1m\u001b[36m======================================================================\u001b[0m\r\n"]
[0.000, "o", "\u001b[1m\u001b[36mEXPERIMENT 0: WARM CACHE (Baseline sanity check)\u001b[0m\r\n"]
[0.000, "o", "\u001b[1m\u001b[36m======================================================================\u001b[0m\r\n"]
[0.000, "o", "Populating Redis key 'user:123' with 60s TTL for warm validation...\r\n"]
[0.099, "o", "Sending 10000 requests to WARM cache...\r\n"]
[2.788, "o", "\r\n--- Benchmark Results [BASELINE] ---\r\nTotal Requests:     10000\r\nSuccess:            9834\r\nErrors:             166\r\nDuration:           2228.83 ms (4486.7 req/s)\r\nCache Misses:       0\r\nDatabase Queries:   0\r\nMax DB Concurrency: 0\r\nLatency (p50 / p95 / p99 / max): 1276.38ms / 1666.41ms / 2011.23ms / 2220.29ms\r\n"]
[0.040, "o", "\r\n"]
[1.006, "o", "\u001b[1m\u001b[36m======================================================================\u001b[0m\r\n\u001b[1m\u001b[36mEXPERIMENT 1: WITHOUT SINGLEFLIGHT (Cache Stampede)\u001b[0m\r\n"]
[0.000, "o", "\u001b[1m\u001b[36m======================================================================\u001b[0m\r\n\r\n\u001b[1mArchitecture Flow:\u001b[0m\r\n"]
[0.015, "o", "      WITHOUT SINGLEFLIGHT\r\n\r\n      10,000 REQUESTS\r\n            │\r\n            ▼\r\n          REDIS\r\n            │\r\n       CACHE MISS\r\n            │\r\n            ▼\r\n        DATABASE\r\n            │\r\n       MANY QUERIES (Thundering Herd!)\r\n"]
[0.000, "o", "\r\nInvalidating cache key 'user:123'...\r\n"]
[0.017, "o", "\u001b[33mCACHE STATUS: COLD / MISS\u001b[0m\r\n\r\n"]
[0.001, "o", "Launching 10000 concurrent requests without request coalescing...\r\n"]
[0.008, "o", "Preparing 10000 concurrent workers targeting http://localhost:8880 (mode: baseline, user_id: 123)...\r\n"]
[0.018, "o", "All workers ready. Releasing start gate barrier for simultaneous burst...\r\n"]
[0.983, "o", "\r\n--- Benchmark Results [BASELINE] ---\r\nTotal Requests:     10000\r\nSuccess:            10000\r\nErrors:             0\r\nDuration:           978.89 ms (10215.6 req/s)\r\nCache Misses:       1066\r\nDatabase Queries:   1066\r\nMax DB Concurrency: 1065\r\nLatency (p50 / p95 / p99 / max): 500.16ms / 762.25ms / 866.29ms / 965.29ms\r\n"]
[0.050, "o", "\r\n"]
[1.012, "o", "\u001b[1m\u001b[36m======================================================================\u001b[0m\r\n\u001b[1m\u001b[36mEXPERIMENT 2: WITH SINGLEFLIGHT (Request Coalescing)\u001b[0m\r\n\u001b[1m\u001b[36m======================================================================\u001b[0m\r\n\r\n\u001b[1mArchitecture Flow:\u001b[0m\r\n"]
[0.002, "o", "       WITH SINGLEFLIGHT\r\n\r\n      10,000 REQUESTS\r\n            │\r\n            ▼\r\n          REDIS\r\n            │\r\n       CACHE MISS\r\n            │\r\n            ▼\r\n       SINGLEFLIGHT\r\n            │\r\n            ▼\r\n        DATABASE\r\n            │\r\n         1 QUERY\r\n            │\r\n            ▼\r\n       SHARED RESULT\r\n            │\r\n            ▼\r\n      10,000 CALLERS\r\n"]
[0.001, "o", "\r\nInvalidating cache key 'user:123'...\r\n"]
[0.027, "o", "\u001b[33mCACHE STATUS: COLD / MISS\u001b[0m\r\n\r\n"]
[0.000, "o", "Launching 10000 concurrent requests WITH Go singleflight...\r\n"]
[0.011, "o", "Preparing 10000 concurrent workers targeting http://localhost:8880 (mode: singleflight, user_id: 123)...\r\n"]
[0.022, "o", "All workers ready. Releasing start gate barrier for simultaneous burst...\r\n"]
[60.140, "o", "\r\n--- Benchmark Results [SINGLEFLIGHT] ---\r\nTotal Requests:     10000\r\nSuccess:            9882\r\nErrors:             118\r\nDuration:           60129.35 ms (166.3 req/s)\r\nCache Misses:       1925\r\nDatabase Queries:   11\r\nMax DB Concurrency: 1\r\nSingleflight Calls:  1925\r\nSingleflight Shared: 1915\r\nLatency (p50 / p95 / p99 / max): 22078.63ms / 30033.84ms / 38266.02ms / 60127.96ms\r\n"]
[0.083, "o", "\r\n"]
[1.007, "o", "\u001b[1m\u001b[36m======================================================================\u001b[0m\r\n\u001b[1m\u001b[36mEMPIRICAL COMPARISON & REDUCTION ANALYSIS\u001b[0m\r\n"]
[0.000, "o", "\u001b[1m\u001b[36m======================================================================\u001b[0m\r\n"]
[0.657, "o", "======================================================================\r\nCOMPARISON SUMMARY: BASELINE vs SINGLEFLIGHT\r\n======================================================================\r\n\r\nMetric                  Baseline (No Coalescing)    Singleflight (Coalesced)\r\n----------------------------------------------------------------------\r\nTotal Requests          10000                       10000                   \r\nCache Misses            1066                        1925                    \r\nDatabase Queries        1066                        11                      \r\nMax DB Concurrency      1065                        1                       \r\nSingleflight Shared     N/A                         1915                    \r\nDuration                978.89                   ms   60129.35              ms\r\nThroughput (RPS)        10215.6                  req/s 166.3                 req/s\r\nLatency p50             500.16                   ms   22078.63              ms\r\nLatency p95             762.25                  "]
[0.000, "o", " ms   30033.84              ms\r\nLatency p99             866.29                   ms   38266.02              ms\r\nLatency Max             965.29                   ms   60127.96              ms\r\nErrors                  0                           118                     \r\n----------------------------------------------------------------------\r\n\r\nANALYSIS:\r\n  * Database work reduction:    96.9x reduction in DB load\r\n  * Database queries:           1066 (baseline) -> 11 (singleflight)\r\n  * Peak DB connection demand:  1065 concurrent -> 1 concurrent\r\n  * Result sharing efficiency:  19.15% of requests piggybacked on in-flight query\r\n\r\n======================================================================\r\n"]
[1.009, "o", "\u001b[1m\u001b[36m======================================================================\u001b[0m\r\n\u001b[1m\u001b[36mEXPERIMENT 3: REAL-WORLD TTL EXPIRATION BURST\u001b[0m\r\n\u001b[1m\u001b[36m======================================================================\u001b[0m\r\n"]
[0.000, "o", "Step 1: Populating Redis key with TTL=2s...\r\n"]
[0.143, "o", "Step 2: Key verified in Redis.\r\nStep 3: Waiting 2 seconds for TTL natural expiration...\r\n"]
[2.219, "o", "\u001b[33mCACHE STATUS: EXPIRED!\u001b[0m\r\n"]
[0.000, "o", "Step 4: Immediately bursting 10000 requests on expired key with singleflight...\r\n"]
[2.737, "o", "\r\n--- Benchmark Results [SINGLEFLIGHT] ---\r\nTotal Requests:     10000\r\nSuccess:            10000\r\nErrors:             0\r\n"]
[0.001, "o", "Duration:           2672.81 ms (3741.4 req/s)\r\nCache Misses:       264\r\nDatabase Queries:   2\r\nMax DB Concurrency: 1\r\nSingleflight Calls:  264\r\nSingleflight Shared: 264\r\nLatency (p50 / p95 / p99 / max): 1438.93ms / 2455.70ms / 2556.45ms / 2626.65ms\r\n"]
[0.116, "o", "\u001b[32mResult after natural TTL expiration burst:\u001b[0m\r\n"]
[0.005, "o", "\"database_queries\":2\r\n"]
[0.003, "o", "\"singleflight_shared\":264\r\n"]
[0.000, "o", "\r\n"]
[1.008, "o", "\u001b[1m\u001b[36m======================================================================\u001b[0m\r\n\u001b[1m\u001b[36mEXPERIMENT 4: MULTI-INSTANCE TOPOLOGY (Process-Local Boundary)\u001b[0m\r\n"]
[0.000, "o", "\u001b[1m\u001b[36m======================================================================\u001b[0m\r\nStarting 3 independent application instances:\r\n  - Instance A (port 8081)\r\n  - Instance B (port 8082)\r\n"]
[0.000, "o", "  - Instance C (port 8083)\r\n"]
[0.166, "o", "\u001b[32m✓ All 3 instances healthy.\u001b[0m\r\nInvalidating cache key 'user:123'...\r\n"]
[0.035, "o", "Sending 10000 concurrent requests distributed across 3 instances...\r\n"]
[0.008, "o", "Preparing 10000 concurrent workers targeting http://localhost:8081, http://localhost:8082, http://localhost:8083 (mode: singleflight, user_id: 123)...\r\n"]
[0.020, "o", "All workers ready. Releasing start gate barrier for simultaneous burst...\r\n"]
[21.812, "o", "\r\n--- Benchmark Results [SINGLEFLIGHT] ---\r\nTotal Requests:     10000\r\nSuccess:            10000\r\nErrors:             0\r\nDuration:           21802.46 ms (458.7 req/s)\r\nCache Misses:       4395\r\nDatabase Queries:   15\r\nMax DB Concurrency: 1\r\nSingleflight Calls:  4395\r\nSingleflight Shared: 4390\r\nLatency (p50 / p95 / p99 / max): 9728.17ms / 12125.95ms / 15283.38ms / 21777.02ms\r\n"]
[0.073, "o", "\r\n\u001b[1mInstance Breakdown:\u001b[0m\r\n"]
[0.054, "o", "  Port 8081 -> DB Queries: 5, Singleflight Shared: 1881\r\n"]
[0.014, "o", "  Port 8082 -> DB Queries: 4, Singleflight Shared: 1486\r\n"]
[0.013, "o", "  Port 8083 -> DB Queries: 6, Singleflight Shared: 1023\r\n\r\n\u001b[33mTakeaway:\u001b[0m\r\n"]
[0.000, "o", "  singleflight is process-local. Each process independently executes its own\r\n"]
[0.001, "o", "  coalesced DB query. To coordinate across multiple instances, combine\r\n"]
[0.000, "o", "  singleflight with distributed locking (e.g. Redis lock) or probabilistic early expiration (SWR).\r\n\r\n"]
[1.008, "o", "\u001b[1m\u001b[36m======================================================================\u001b[0m\r\n"]
[0.000, "o", "\u001b[1m\u001b[36mSUMMARY & LESSONS\u001b[0m\r\n"]
[0.000, "o", "\u001b[1m\u001b[36m======================================================================\u001b[0m\r\n"]
[0.008, "o", "      CACHE\r\n        │\r\n        ▼ Reduces normal database traffic\r\n  \r\n  SINGLEFLIGHT\r\n        │\r\n        ▼ Deduplicates concurrent identical work within the process\r\n  \r\n  DISTRIBUTED LOCK / SWR / JITTER\r\n        │\r\n        ▼ Additional techniques for cross-instance protection & stagger\r\n"]
[0.000, "o", "\r\n"]
