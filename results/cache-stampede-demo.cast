[3.491, "o", "\u001b[32m✓ Binaries built successfully.\u001b[0m\r\n\r\n\u001b[1m[2/7] Starting Infrastructure (Docker Compose)...\u001b[0m\r\n"]
[0.452, "o", "\u001b[?25l\u001b[0G[+] up 2/2\r\n \u001b[32m✔\u001b[0m Container csd-redis    \u001b[32mRunning\u001b[0m                                           \u001b[34m0.0s\u001b[0m\r\n \u001b[32m✔\u001b[0m Container csd-postgres \u001b[32mRunning\u001b[0m                                           \u001b[34m0.0s\u001b[0m\r\n\u001b[?25h"]
