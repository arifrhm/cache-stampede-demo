[0.020, "o", "\u001b[1m\u001b[36m======================================================================\u001b[0m\r\n\u001b[1m\u001b[36m  CACHE STAMPEDE (THUNDERING HERD) vs GO SINGLEFLIGHT DEMO           \u001b[0m\r\n\u001b[1m\u001b[36m======================================================================\u001b[0m\r\nConfiguration:\r\n"]
[0.000, "o", "  Requests:           10000\r\n  Concurrency:        10000\r\n  DB Latency:         100ms\r\n  DB Max Connections: 20\r\n  Cache TTL:          2s\r\n"]
